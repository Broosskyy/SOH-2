; Engine configuration file.
; Abyssal Dominion cross-platform client migration base.
config_version=5

[application]

config/name="Abyssal Dominion"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.5.3"
config/icon="res://assets/ui/app_icon.svg"
boot_splash/bg_color=Color(0.015, 0.08, 0.12, 1)

[autoload]

MobileWebDiagnostics="*res://scripts/debug/mobile_web_diagnostics.gd"
PlatformService="*res://scripts/platform/platform_service.gd"
QualityManager="*res://scripts/quality/quality_manager.gd"
GameState="*res://scripts/core/game_state.gd"
TargetingSystem="*res://scripts/combat/targeting_system.gd"
MobileWebBootTelemetry="*res://scripts/debug/mobile_web_boot_telemetry.gd"
RuntimeQaMarker="*res://scripts/debug/runtime_qa_marker.gd"
WebViewportContract="*res://scripts/platform/web_viewport_contract.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input]

moveForward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
moveBackward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
steerLeft={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
steerRight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
selectTarget={
"deadzone": 0.2,
"events": []
}
cycleTarget={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194308)]
}
primaryFire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
harpoonFire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
ability1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
ability2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
ability3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
cancelNavigation={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
zoomIn={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
zoomOut={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
openMap={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
openShipyard={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.08, 0.32, 0.42, 1)

[physics]

common/physics_ticks_per_second=60
