extends Node
func _ready()->void:
	var markers:=JSON.parse_string(FileAccess.get_file_as_string("res://data/m79_marker_priority.json"))
	assert(int(markers.priority.event_portal)==84)
	assert(int(markers.priority.event_wreck)==73)
	assert(int(markers.priority.event_boss)==96)
	var audit:=JSON.parse_string(FileAccess.get_file_as_string("res://data/m96_event_interaction_vfx_admin_audit.json"))
	assert(bool(audit.halloween.wreck_proximity_interaction))
	assert(bool(audit.halloween.gravefire_runtime_vfx))
	assert(bool(audit.admin.asset_browser))
	assert(not bool(audit.admin.production_authority))
	assert(not bool(audit.halloween.live_reward_authority))
	var slots:=JSON.parse_string(FileAccess.get_file_as_string("res://data/visual_slots.json"))
	assert(slots.vfx.has("ammo_gravefire_impact"))
	assert(slots.vfx.has("vfx_halloween_portal"))
	assert(slots.vfx.has("vfx_halloween_boss_arrival"))
	var prod:=JSON.parse_string(FileAccess.get_file_as_string("res://data/m96_asset_production_wave.json"))
	assert(prod.master_first_13.size()==13)
	print("M96_EVENT_INTERACTION_ADMIN_VFX_PASS")
