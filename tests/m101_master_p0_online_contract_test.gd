extends Node
func _ready()->void:
	var p0:=JSON.parse_string(FileAccess.get_file_as_string("res://data/m101_p0_replacement_matrix.json"))
	assert(p0.assets.size()==13)
	var env:=JSON.parse_string(FileAccess.get_file_as_string("res://data/environment_contract.json"))
	assert(env.environments.has("LOCAL_DEVELOPMENT"))
	assert(env.environments.has("TESTSERVER"))
	assert(env.environments.has("GLOBAL_PRODUCTION"))
	assert(not bool(env.environments.LOCAL_DEVELOPMENT.persistent_live_ownership))
	var auth:=JSON.parse_string(FileAccess.get_file_as_string("res://data/server_authority_boundary.json"))
	assert(auth.future_server_authoritative.has("combat"))
	assert(auth.future_server_authoritative.has("premium entitlements"))
	var release:=JSON.parse_string(FileAccess.get_file_as_string("res://data/release_identity.json"))
	assert(str(release.environment)=="LOCAL_DEVELOPMENT")
	assert(int(release.build_number)==101)
	var align:=JSON.parse_string(FileAccess.get_file_as_string("res://data/m101_master_alignment_audit.json"))
	assert(not bool(align.master_alignment.v3_7_source_available_in_files))
	assert(not bool(align.online_architecture.real_backend))
	assert(not bool(align.staff.production_admin_authority))
	print("M101_MASTER_P0_ONLINE_CONTRACT_PASS")
