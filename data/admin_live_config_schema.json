  "workflow": {
    "states": [
      "draft",
      "validated",
      "scheduled",
      "active",
      "rolled_back"
    ],
    "four_eyes_for": [
      "real_money_price",
      "premium_currency",
      "entitlement_mapping",
      "commerce_publish",
      "payment_refund",
      "admin_grant",
      "admin_ban",
      "server_operation"
    ],
    "audit_log": true,
    "versioned": true,
    "rollback": true
  },
  "authority": {
    "gameplay_balance": "active server config eventually",
    "real_money_price": "server/payment provider",
    "entitlement_grant": "server only",
    "client": "read-only effective config + fallback defaults"
  },
  "validation": {
    "numeric_min_max_required": true,
    "referential_integrity": true,
    "currency_mismatch_blocked": true,
    "unknown_item_blocked": true,
    "production_publish_requires_permission": true
  },
  "surfaces": {
    "web_admin": "full content/balance/liveops/payment management",
    "ingame_admin": "same content service with role-filtered mobile/desktop UI",
    "shared_backend": true
  },
  "rbac": {
    "enabled": true,
    "contract": "res://data/admin_rbac_contract.json",
    "same_roles_on": [
      "web_admin",
      "ingame_admin"
    ],
    "deny_by_default": true,
    "server_verified": true
  }
}
