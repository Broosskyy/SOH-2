  "unset_until_native_qa": ["camera_feel", "tap_tolerance", "hud_overlap_thresholds", "combat_feedback_timing", "wake_vfx_budget", "simultaneous_projectile_budget", "damage_vfx_budget", "sinking_duration", "mobile_frame_budget", "memory_budget", "audio_mix", "haptic_strength"]
