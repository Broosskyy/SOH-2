      ]
    },
    {
      "id": "shipyard_selection",
      "rules": [
        "selected_ship_is_explicit",
        "ownership_state_visible",
        "comparison_preview_preserved"
      ]
    },
    {
      "id": "overlay_back",
      "rules": [
        "ui_cancel_closes_topmost_panel",
        "no_gameplay_camera_mutation"
      ]
    }
  ],
  "mobile_panel_rules": {
    "touch_target": 50,
    "horizontal_scroll": false,
    "safe_area": true,
    "selection_state": "explicit"
