; Abyssal Dominion M303 independent classic-chart local prototype
; Godot 4.7.2 / Compatibility renderer

config_version=5

[application]

; Keep the actual M29 storage identity (M28); renaming would orphan user saves.
; EntryFlow sets the visible native window title to the current milestone.
config/name="Abyssal Dominion"
config/version="0.303.5"
run/main_scene="res://scenes/classic/classic_sea_map.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/production/ui/app_icon.svg"
boot_splash/image="res://assets/production/ui/splash.png"
boot_splash/bg_color=Color(0.02, 0.07, 0.11, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode=3
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input]

inventory_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":73), Object(InputEventJoypadButton,"button_index":7)]
}

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
turn_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
turn_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
respawn={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
map_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77), Object(InputEventJoypadButton,"button_index":6)]
}
target_next={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84), Object(InputEventJoypadButton,"button_index":2)]
}
cycle_cannon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
cycle_ammo={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":88)]
}
repair={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventJoypadButton,"button_index":1)]
}
ability={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":3)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"button_index":4)]
}
shop_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71), Object(InputEventJoypadButton,"button_index":3)]
}
upgrade_hull={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49), Object(InputEventJoypadButton,"button_index":0)]
}
upgrade_cannon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50), Object(InputEventJoypadButton,"button_index":1)]
}
upgrade_sails={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51), Object(InputEventJoypadButton,"button_index":2)]
}
ship_previous={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":91), Object(InputEventJoypadButton,"button_index":9)]
}
ship_next={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":93), Object(InputEventJoypadButton,"button_index":10)]
}
ship_select={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":5)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}

[input_devices]

; Android touch taps are forwarded as mouse clicks to the local M303 sea map.
pointing/emulate_mouse_from_touch=true

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/inferred_declaration=0

[physics]

3d/physics_engine="GodotPhysics3D"
common/enable_pause_aware_picking=true
3d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.19, 0.42, 0.56, 1)
