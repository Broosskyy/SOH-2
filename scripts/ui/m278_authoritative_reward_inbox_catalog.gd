class_name M278AuthoritativeRewardInboxCatalog
extends RefCounted
static func overview(runtime:M278AuthoritativeRewardInboxRuntime)->Dictionary:
	if runtime==null:return {"title":"Reward Inbox · Claim Queue","state":"SERVER REQUIRED","detail":"Keine autoritative Reward-Inbox-Replica gebunden."}
	var s:=runtime.snapshot(); return {"title":"Reward Inbox · Claim Queue","state":"SERVER REPLICA" if int(s.get("inbox_revision",-1))>=0 else "WAITING","detail":"Encounter %s · inbox rev %d · queue rev %d"%[str(s.get("encounter_id","UNBOUND")),int(s.get("inbox_revision",-1)),int(s.get("queue_revision",-1))]}
static func inbox()->Dictionary: return {"title":"Inbox · Pending Rewards","state":"FAIL-CLOSED FOUNDATION","detail":"Mehrere ausstehende Rewards werden über servereigene Inbox-Entries mit Receipt-/Transaction-/Idempotency-Bindung geführt. Der Client kann keine Entries oder Anhänge erzeugen."}
static func queue()->Dictionary: return {"title":"Claim Queue · Ordering","state":"SERVER AUTHORITATIVE","detail":"Claims können als Intents eingereiht werden; Reihenfolge, Verarbeitung, Blockierung und Wiederaufnahme gehören dem Server. Retry/Reconnect erzeugt keine zweite Zustellung."}
static func overflow()->Dictionary: return {"title":"Capacity · Overflow · Mail","state":"SAFE FALLBACK","detail":"Kapazitätsfehler erzeugen keinen Ersatzbesitz. Server kann bestätigte Rewards blockieren, als Overflow halten oder über den bestehenden M254/M277-Fallback weiterführen."}
static func expiry()->Dictionary: return {"title":"Expiry · Retention","state":"SERVER POLICY ONLY","detail":"Ablauf, Retention, Grace und Revocation sind serverseitige Policy-Entscheidungen. Der Client kann Fristen weder verlängern noch abgelaufene Rewards reaktivieren."}
static func compensation()->Dictionary: return {"title":"Compensation · Recovery","state":"NO CLIENT MINTING","detail":"Compensation ist nur eine serverautorisierte Recovery-Entscheidung mit stabiler Audit-/Idempotency-Spur und muss für dauerhaften Wert erneut durch M266 settlement laufen."}
static func authority()->Dictionary: return {"title":"Reward Inbox Authority","state":"FAIL-CLOSED","detail":"Client darf Inbox anzeigen, Refresh-/Claim-Queue-Intents senden und bestätigte Fehler darstellen; Entry-Erstellung, Queue-Priorität, Capacity-Override, Expiry, Compensation und Settlement bleiben serverseitig. TEST/GLOBAL bleiben getrennt."}
