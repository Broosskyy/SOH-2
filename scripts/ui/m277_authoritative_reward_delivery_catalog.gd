class_name M277AuthoritativeRewardDeliveryCatalog
extends RefCounted
static func overview(runtime:M277AuthoritativeRewardDeliveryRuntime)->Dictionary:
	if runtime==null:return {"title":"Reward Receipt · Claim Delivery","state":"SERVER REQUIRED","detail":"Keine autoritative Reward-Delivery-Replica gebunden."}
	var s:=runtime.snapshot(); return {"title":"Reward Receipt · Claim Delivery","state":"SERVER REPLICA" if int(s.get("receipt_revision",-1))>=0 else "WAITING","detail":"Encounter %s · receipt rev %d · delivery rev %d"%[str(s.get("encounter_id","UNBOUND")),int(s.get("receipt_revision",-1)),int(s.get("delivery_revision",-1))]}
static func receipts()->Dictionary: return {"title":"Receipt · Claim · Idempotency","state":"FAIL-CLOSED FOUNDATION","detail":"Receipt-ID, Transaction-ID, Idempotency-Key, Beneficiary und Reward-Bundle-Digest gehören dem Server. Retry/Reconnect darf denselben Receipt weiterführen, keinen zweiten Reward erzeugen."}
static func delivery()->Dictionary: return {"title":"Delivery · Capacity · Failure","state":"SERVER AUTHORITATIVE","detail":"Inventar/Wallet/Ownership-Zustellung wird nur nach M266-Settlement bestätigt. Volles Inventar oder Zustellfehler erzeugen keinen lokalen Ersatzbesitz."}
static func mail_fallback()->Dictionary: return {"title":"Mail / Claim-Inbox Fallback","state":"M254 SERVER CHANNEL","detail":"Nicht direkt zustellbare bestätigte Rewards können serverseitig in Mail/Claim-Inbox geparkt werden. Der Client kann weder Anhänge erzeugen noch Zustellung/Claim settlement bestätigen."}
static func recovery()->Dictionary: return {"title":"Reconnect · Recovery · Audit","state":"IDEMPOTENT RECOVERY","detail":"Post-Settlement-Recovery nutzt Receipt-/Delivery-/Audit-Revisionen. Disconnect, Retry oder Crash dürfen weder Verlust noch Doppelzustellung erzeugen; Audit-Evidence bleibt serverseitig."}
static func settlement()->Dictionary: return {"title":"Durable Ownership","state":"M266 ONLY","detail":"M277 verwaltet Receipt/Delivery/Recovery. Nur M266 darf dauerhaften Inventar-, Wallet- oder Ownership-Wert und das zugrunde liegende Transaction-Receipt erzeugen."}
static func authority()->Dictionary: return {"title":"Reward Delivery Authority","state":"FAIL-CLOSED","detail":"Client darf Claim-Intent senden und bestätigte Zustände anzeigen, aber Receipt, Beneficiary, Reward-Anhang, Mail-Fallback, Delivery, Recovery, Audit oder Settlement niemals autorisieren. TEST/GLOBAL bleiben getrennt."}
