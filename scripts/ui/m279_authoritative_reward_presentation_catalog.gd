class_name M279AuthoritativeRewardPresentationCatalog
extends RefCounted
static func overview(runtime:M279AuthoritativeRewardPresentationRuntime)->Dictionary:
	if runtime==null:return {"title":"Reward Presentation · Claim UX","state":"SERVER REQUIRED","detail":"Keine autoritative Reward-Presentation-Replica gebunden."}
	var s:=runtime.snapshot(); return {"title":"Reward Presentation · Claim UX","state":"SERVER REPLICA" if int(s.get("presentation_revision",-1))>=0 else "WAITING","detail":"Encounter %s · presentation rev %d · notification seq %d"%[str(s.get("encounter_id","UNBOUND")),int(s.get("presentation_revision",-1)),int(s.get("notification_sequence",-1))]}
static func seachart_feedback()->Dictionary: return {"title":"Sea Chart · Reward Feedback","state":"PRESENTATION ONLY","detail":"Bestätigte Kills/Encounter dürfen kurze Loot-/Reward-Banner, Icons, Mengen und Zustellstatus darstellen. Sichtbares Feedback erzeugt niemals Besitz oder Claim-Erfolg."}
static func boss_admiral()->Dictionary: return {"title":"Boss / Admiral Rewards","state":"SERVER CONFIRMED","detail":"Boss-/Admiral-Rewards werden erst nach bestätigter M274–M278-Kette prominent präsentiert. Telegraphie und Reward-Reveal bleiben lesbar, ohne clientseitige Rolls oder Werteautorität."}
static func badges()->Dictionary: return {"title":"Inbox Badge · Notification","state":"SERVER DERIVED","detail":"Badge-Zahl und ungelesene Reward-Hinweise stammen aus bestätigtem Inbox-/Presentation-State. Der Client darf nur Animation, Dismiss und Navigation lokal steuern."}
static func claim_ux()->Dictionary: return {"title":"Claim UX · Mobile / Desktop","state":"PARITY FOUNDATION","detail":"Claimable, Queue, Capacity Block, Mail Fallback, Recovery und Settled erhalten klare Zustände mit großen Touch-Zielen und Desktop/Mobile-Parität; keine erfolglose Silent-Action."}
static func hierarchy()->Dictionary: return {"title":"Reward UX Hierarchy","state":"SEA-FIRST","detail":"Seekarten-Feedback bleibt primär und kurz; Inbox/Claim ist sekundär. Kein zusätzliches Reward-Hauptmenü und kein dauerhaftes Loot-Debug-HUD."}
static func authority()->Dictionary: return {"title":"Reward Presentation Authority","state":"FAIL-CLOSED","detail":"Client darf bestätigte Reward-Daten darstellen, Animationen abspielen, Präsentation visuell schließen und zur Claim-Fläche navigieren. Rewardwert, Rarity/Menge, Badge-Wahrheit, Claim-Erfolg und Settlement bleiben serverseitig; TEST/GLOBAL getrennt."}
